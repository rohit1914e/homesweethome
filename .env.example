# Copy to .env for local development. On Render, DATABASE_URL is linked automatically by render.yaml.
# Never commit a real .env.

# PostgreSQL connection string. Local: `npm run db:local` creates this cluster.
DATABASE_URL=postgres://postgres@localhost:55432/homesweethome
# TLS for the database: auto-detected (on for Render *external* URLs ending in .render.com). Force with true/false.
# DATABASE_SSL=
NODE_ENV=development
PORT=3000
# HOST=0.0.0.0
# Initial GPS places for Home / College status: "lat,lng,radiusM" (applied once; Rohit edits them in Settings).
# Keep real coordinates out of git — set them in .env locally and in the Render dashboard.
# HOME_PLACE=
# COLLEGE_PLACE=
# Session lifetime in days (sliding).
# SESSION_DAYS=30
# Secure cookies: defaults to true when NODE_ENV=production.
# COOKIE_SECURE=
# Proxy hops in front of the app (Render = 1, default in production).
# TRUST_PROXY=
